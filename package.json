{
  "name": "baekjoonhub",
  "version": "2.0.0",
  "description": "Chrome extension that automatically pushes your code to GitHub from competitive programming platforms",
  "main": "index.js",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "dev": "webpack --watch --config webpack.config.js",
    "package": "npm run build && node build.js",
    "clean": "rm -rf dist packages node_modules"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "chrome-extension",
    "baekjoonhub",
    "competitive-programming",
    "github-integration"
  ],
  "author": "getCurrentThread",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ssafytoday/SsafyToday.git"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^13.0.0",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "js-sha1": "^0.6.0",
    "safe-template-parser": "^1.0.0"
  }
}
